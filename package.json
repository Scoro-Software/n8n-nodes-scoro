{
  "name": "@scoro/n8n-nodes-scoro",
  "version": "0.1.0",
  "description": "n8n community node for Scoro: a Scoro OAuth2 API credential for the HTTP Request node and a Scoro Trigger for webhook events (API v4)",
  "license": "MIT",
  "homepage": "https://github.com/Scoro-Software/n8n-nodes-scoro#readme",
  "bugs": {
    "url": "https://github.com/Scoro-Software/n8n-nodes-scoro/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "scoro",
    "scoro-api",
    "work-management",
    "crm",
    "invoicing",
    "project-management"
  ],
  "author": {
    "name": "Scoro Software",
    "email": "developers@scoro.com",
    "url": "https://www.scoro.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scoro-Software/n8n-nodes-scoro.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ScoroOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Scoro/ScoroTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
