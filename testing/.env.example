# Copy to testing/.env (git-ignored). Nothing here is read by the node itself; these values
# are what you type into the n8n UI while testing, kept in one place.

# Scoro site to test against (a trial site, never a customer site), on any Scoro domain
SCORO_SITE_URL=https://mycompany.scoro.com

# OAuth client from a *private* Developer Portal app (https://developers.scoro.com) that lists
#   Site URL:      <SCORO_SITE_URL>
#   Callback URL:  http://localhost:5678/rest/oauth2-credential/callback
# and whose "Manage access" covers the scopes in credentials/ScoroOAuth2Api.credentials.ts
#   (ai:rw is required for the Eli resource of the Scoro node).
SCORO_CLIENT_ID=
SCORO_CLIENT_SECRET=

# Optional: company account identifier on a multi-entity site
SCORO_COMPANY_ACCOUNT=

# Local n8n owner account created on first start (throwaway values)
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=
